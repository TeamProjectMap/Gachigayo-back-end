<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.baegopa.onestep.mapper.IEasyGuideMapper">

    <select id="getEasyTexts" resultType="com.baegopa.onestep.dto.EasyGuideTextDTO">
        SELECT easyGuideTextId,
               originalHash,
               originalText,
               easyText,
               model
        FROM EASY_GUIDE_TEXTS
        WHERE originalHash IN
        <foreach collection="hashes" item="hash" open="(" separator="," close=")">
            #{hash}
        </foreach>
    </select>

    <!-- 여러 요청이 동시에 같은 문장을 저장해도 하나만 남는다 -->
    <insert id="insertEasyText" parameterType="com.baegopa.onestep.dto.EasyGuideTextDTO">
        INSERT IGNORE INTO EASY_GUIDE_TEXTS (
            originalHash,
            originalText,
            easyText,
            model
        ) VALUES (
            #{originalHash},
            #{originalText},
            #{easyText},
            #{model}
        )
    </insert>

</mapper>
